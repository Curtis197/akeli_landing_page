# Supabase — required
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Clé serveur Supabase (sb_secret_...) — requise pour les API routes (leads, tracking).
# Les clés legacy service_role (JWT eyJ...) sont désactivées depuis le 2026-06-23.
SUPABASE_SECRET_KEY=sb_secret_...

# App URL — used for auth redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

GEMINI_API_KEY=your_gemini_api_key_here

# Secret for signing session-close tokens — generate with: openssl rand -hex 32
TRACKING_CLOSE_SECRET=your_random_secret_here

# Liens d'accès anticipé (optionnels — l'e-mail lead s'adapte s'ils sont absents)
TESTFLIGHT_PUBLIC_LINK=
PLAY_OPTIN_LINK=