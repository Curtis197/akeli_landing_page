# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# MCP config (may contain API keys)
.mcp.json

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
test-*.mjs

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# local normalization scratch (data dumps + one-off debug scripts — not committed)
/batch_normalization_report.json
/fetched_recipes_data.json
/query_db.js
/generate_descriptions.py
/batch_translate_steps.js
